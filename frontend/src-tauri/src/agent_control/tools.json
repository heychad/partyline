  {
    "name": "partyline_recording",
    "description": "Start, pause, resume, or stop cloud capture using the same native commands as the app. Start uses supplied fields (empty title, no suggestions, and default microphone if omitted). It sends audio to AssemblyAI and transcript text to OpenAI. Pause keeps provider sessions open. Stop returns before final notes finish; poll status or meetings/get.",
    "inputSchema": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "start"
            },
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 200
            },
            "participants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "microphone": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512,
              "description": "Input name from partyline_audio/list; empty means system default."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "pause"
            },
            "expected_meeting_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "expected_meeting_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "resume"
            },
            "expected_meeting_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "expected_meeting_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "stop"
            },
            "expected_meeting_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "expected_meeting_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "_meta": {
      "partyline/permissions": {
        "start": "control",
        "pause": "control",
        "resume": "control",
        "stop": "control"
      },
      "partyline/labels": {
        "start": "Start recording",
        "pause": "Pause recording",
        "resume": "Resume recording",
        "stop": "Stop recording"
      }
    }
  },
  {
    "name": "partyline_speakers",
    "description": "Read participant suggestions and detected speaker IDs, or confirm a name. An empty name clears confirmation. ME and unidentified speakers cannot be renamed. Suggestions never assign identities automatically; confirmation updates transcript labels and invalidates notes.",
    "inputSchema": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "list"
