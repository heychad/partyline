[
  {
    "name": "partyline_status",
    "description": "Read app and recording status or recent agent activity. Agent access is a saved human-controlled setting; tools cannot change it. Show, hide, or quit the app. Quit uses the normal recording drain; provide expected_meeting_id if a meeting is active.",
    "inputSchema": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "get"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "activity"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "show"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "hide"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "quit"
            },
            "expected_meeting_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "partyline/permissions": {
        "get": "read",
        "activity": "read",
        "show": "control",
        "hide": "control",
        "quit": "control"
      },
      "partyline/labels": {
        "get": "Read app status",
        "activity": "Read agent activity",
        "show": "Show PartyLine",
        "hide": "Hide PartyLine",
        "quit": "Quit PartyLine"
      }
    }
  },
  {
    "name": "partyline_audio",
    "description": "List inputs, inspect timestamped live audio levels and connection warnings, or select the next microphone in the setup form. Diagnostics do not start capture. Device changes during recording are unsupported.",
