              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "new"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "prepare"
            },
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 200
            },
            "participants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "microphone": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512,
              "description": "Input name from partyline_audio/list; empty means system default."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "follow"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "enabled"
          ],
          "additionalProperties": false
        },
