        "list": "read",
        "diagnostics": "read",
        "select": "control"
      },
      "partyline/labels": {
        "list": "List microphones",
        "diagnostics": "Read audio diagnostics",
        "select": "Select next microphone"
      }
    }
  },
  {
    "name": "partyline_meetings",
