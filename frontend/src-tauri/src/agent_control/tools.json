            }
          },
          "required": [
            "action",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "transcript"
            },
            "id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 36,
              "format": "uuid"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "final_only": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "open"
            },
            "id": {
