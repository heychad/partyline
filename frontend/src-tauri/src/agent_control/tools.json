              "const": "diagnostics"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "select"
            },
            "microphone": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512,
              "description": "Input name from partyline_audio/list; empty means system default."
            }
          },
          "required": [
            "action",
            "microphone"
          ],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
